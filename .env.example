# ─────────────────────────────────────────────────────────────────────────────
# Ganja Livre – Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use a strong random password. In production, prefer a MongoDB Atlas URI with TLS.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGODB_DATABASE=ganja-livre
MONGODB_MAX_POOL_SIZE=100
MONGODB_CONNECT_TIMEOUT=10s

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_HEX_REFRESH_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h   # 7 days

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ganja-livre-sales

# ── Temporal PostgreSQL (internal Temporal dependency) ────────────────────────
TEMPORAL_DB_PASSWORD=CHANGE_ME_TEMPORAL_DB_PASSWORD
